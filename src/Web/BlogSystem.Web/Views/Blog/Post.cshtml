@using System.Globalization
@using System.Net
@using BlogSystem.Common
@using Microsoft.AspNetCore.Http.Extensions
@model BlogSystem.Web.ViewModels.Blog.BlogPostViewModel

@{
    ViewBag.Title = Model.Title;

    var articleJsonLd = new
    {
        context = "https://schema.org",
        type = "BlogPosting",
        headline = Model.Title,
        description = Model.MetaDescription,
        keywords = Model.MetaKeywords,
        datePublished = Model.CreatedOn.ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture),
        dateModified = (Model.ModifiedOn ?? Model.CreatedOn).ToString("yyyy-MM-ddTHH:mm:ssZ", CultureInfo.InvariantCulture),
        image = (string)ViewBag.OgImage,
        mainEntityOfPage = (string)ViewBag.Canonical,
        url = (string)ViewBag.Canonical,
        author = new { type = "Person", name = GlobalConstants.SiteAuthor, url = GlobalConstants.SystemBaseUrl },
        publisher = new { type = "Person", name = GlobalConstants.SiteAuthor, url = GlobalConstants.SystemBaseUrl },
        inLanguage = "en",
    };
    // schema.org needs "@context"/"@type"; anonymous-type members cannot start with '@'.
    var articleJson = System.Text.Json.JsonSerializer.Serialize(articleJsonLd)
        .Replace("\"context\":", "\"@context\":")
        .Replace("\"type\":", "\"@type\":");
}

@Html.Raw("<script type=\"application/ld+json\">" + articleJson + "</script>")

<article class="blog-post">
    <div class="blog-post-meta">
        <span class="me-3"><i class="fa fa-calendar"></i> <time datetime="@Model.CreatedOn.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)">@Model.CreatedOn.ToString("MMMM dd, yyyy", CultureInfo.InvariantCulture)</time></span>
        <span class="me-3"><i class="fa fa-pencil-alt"></i> @GlobalConstants.SiteAuthor</span>
        @if (this.User.IsInRole(GlobalConstants.AdministratorRoleName))
        {
            <span><i class="fa fa-pencil-alt"></i> <a href="/Administration/BlogPosts/Edit/@Model.Id">Edit</a></span>
        }
    </div>
    <div class="blog-post-content">
        @Html.Raw(Model.Content)
    </div>

    <div id="social-button-sharer" class="mt-4">
        <a class="twitter-share-button" href="https://twitter.com/intent/tweet">Tweet</a>
        <script>
            window.twttr = (function (d, s, id) {
                var js, fjs = d.getElementsByTagName(s)[0],
                    t = window.twttr || {};
                if (d.getElementById(id)) return t;
                js = d.createElement(s);
                js.id = id;
                js.src = "https://platform.twitter.com/widgets.js";
                fjs.parentNode.insertBefore(js, fjs);
                t._e = [];
                t.ready = function (f) {
                    t._e.push(f);
                };
                return t;
            }(document, "script", "twitter-wjs"));
        </script>

        <div id="fb-root"></div>
        <script async defer crossorigin="anonymous" src="https://connect.facebook.net/en_GB/sdk.js#xfbml=1&version=v5.0&appId=155172444599081&autoLogAppEvents=1"></script>
        <div class="fb-share-button" data-href="@this.Context.Request.GetDisplayUrl()" data-layout="button_count" data-size="small">
            <a target="_blank" href="https://www.facebook.com/sharer/sharer.php?u=@WebUtility.UrlEncode(this.Context.Request.GetDisplayUrl())&amp;src=sdkpreparse" class="fb-xfbml-parse-ignore">Share</a>
        </div>
    </div>
</article>
